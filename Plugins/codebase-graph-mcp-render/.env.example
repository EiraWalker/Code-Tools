# Copy to .env locally. Replace placeholders through a private configuration flow.
CBM_PROJECT=your-project-cache-stem
CBM_SOURCE_REPOSITORY=owner/private-repository
CBM_GRAPH_PATH=path/to/your-project-cache-stem.db
CBM_GRAPH_SHA256=
CBM_GRAPH_BLOB_SHA=
CBM_GRAPH_URL=
CBM_GRAPH_BEARER_TOKEN=
CBM_SERVICE_TOKEN=
CBM_CACHE_DIR=.runtime/cache
CBM_BINARY=backend/.cbm-upstream/build/c/codebase-memory-mcp
CBM_BIND_HOST=127.0.0.1
CBM_PUBLIC_ORIGIN=http://127.0.0.1:8080
PORT=8080
# Gateway only: assign the returned Render origin, never a guessed hostname.
CBM_ENGINE_ORIGIN=
